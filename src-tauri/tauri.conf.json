{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghyna",
  "version": "1.1.6",
  "identifier": "com.ghyna.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ghyna",
        "width": 900,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "focusable": true,
        "visible": false,
        "dragDropEnabled": true,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMUUyQjU3OUI2RDJBODUKUldTRkttMmJWeXNlYnovcXIrbUIvU0tzTk1IenhBOXQ2bUhpZ28wMHl6bkVzcGtkRkszN3B6WHcK",
      "endpoints": ["https://github.com/nandarjr660/Ghyna/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
